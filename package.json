{
  "name": "clinic-system",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "pnpm --filter @clinic/shared build",
    "build": "pnpm build:shared && pnpm -r --filter=!@clinic/shared build",
    "typecheck": "pnpm build:shared && pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm build:shared && pnpm -r test",
    "codegen": "pnpm --filter @clinic/api schema:emit && pnpm --filter @clinic/shared codegen",
    "db:generate": "pnpm --filter @clinic/shared db:generate",
    "db:migrate": "pnpm --filter @clinic/shared db:migrate"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
