# Скопіюйте в .env. Секретів у репозиторії немає; значення нижче лише для локальної розробки.
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
# Порт Postgres на хості (змініть, якщо 5432 зайнятий; узгодьте з DATABASE_URL нижче)
POSTGRES_PORT=5432

# Для запуску поза docker (pnpm db:migrate, pnpm --filter @clinic/api start)
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
# Порт Redis на хості (змініть, якщо 6379 зайнятий; узгодьте з REDIS_URL нижче)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
API_PORT=4000

# Mailpit (локальний SMTP-перехоплювач; зовнішніх сервісів пошти немає)
SMTP_HOST=localhost
SMTP_PORT=1025

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000